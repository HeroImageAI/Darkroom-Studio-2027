{
  "name": "darkroom-studio-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:workflows": "tsx scripts/check-workflows.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "format": "prettier --write apps packages scripts tests *.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.6",
    "@fontsource/inter": "5.3.0",
    "fastify": "5.12.7",
    "opentype.js": "2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/opentype.js": "1.3.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
